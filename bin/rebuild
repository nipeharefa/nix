#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'USAGE'
Usage: rebuild [host]

Rebuilds the darwin host (default: m1pro) with sudo (nix-darwin now
requires root for switch) and updates the nipeharefa home-manager
profile as the invoking user (never as root).
USAGE
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
host="${1:-m1pro}"

run_as_user() {
  if [[ $(id -u) -eq 0 ]]; then
    sudo -u "${SUDO_USER:-nipeharefa}" --set-home -- "$@"
  else
    "$@"
  fi
}

echo "==> Rebuilding darwin host: ${host}"
if [[ $(id -u) -eq 0 ]]; then
  darwin-rebuild switch --flake "${repo_root}#${host}"
else
  sudo darwin-rebuild switch --flake "${repo_root}#${host}"
fi

echo "==> Updating home-manager profile"
run_as_user home-manager switch --flake "${repo_root}#nipeharefa"
